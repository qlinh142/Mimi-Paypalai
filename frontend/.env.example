# mock: dữ liệu mẫu trong trình duyệt, không cần Firebase hay backend. live: gọi /api thật.
VITE_API_MODE=mock

# Chỉ cần khi VITE_API_MODE=live
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_RECAPTCHA_ENTERPRISE_KEY=
VITE_USE_EMULATORS=false

# PayPal JS SDK (sandbox client ID). Để trống: nút "Thanh toán (mô phỏng PayPal sandbox)"
# dùng khi backend chạy PAYPAL_MODE=fake hoặc ở chế độ mock.
VITE_PAYPAL_CLIENT_ID=

# Giao diện mới (Mimi UI Redesign). Đặt 0 để quay về giao diện cũ.
VITE_UI_V2=1

# AG Studio (màn Phân tích chi tiêu). Khóa dùng thử 45 ngày nằm ở frontend như khóa AG Grid,
# không phải bí mật. Để trống: Studio vẫn chạy đủ tính năng, chỉ hiện watermark.
VITE_AG_STUDIO_LICENSE=
