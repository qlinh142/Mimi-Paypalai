{
  "name": "mimi-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:proto": "tsc -b && vite build -c vite.proto.config.ts && node scripts/inline-proto.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "gen:api": "openapi-typescript ../backend/api/openapi.yaml -o src/api/schema.d.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@tanstack/query-async-storage-persister": "^5.104.3",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-query-persist-client": "^5.104.3",
    "firebase": "^13.0.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0"
  }
